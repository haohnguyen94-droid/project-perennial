# Copy this file to .env and fill in your real keys
# cp .env.example .env  (Mac/Linux)
# copy .env.example .env  (Windows)

# Congress trades (Hao)
FMP_API_KEY=your_fmp_key_here

# Insider trades (Hao)
FINNHUB_API_KEY=your_finnhub_key_here

# Short interest — FINRA Consolidated Equity Short Interest (Hao)
FINRA_API_URL=https://api.finra.org/data/group/equity/service/shortInterest
FINRA_CLIENT_ID=your_finra_client_id
FINRA_CLIENT_SECRET=your_finra_client_secret
FINRA_API_KEY=your_finra_api_key

# Sentiment - YouTube (Cohen)
YOUTUBE_API_KEY=your_youtube_key_here

# Sentiment - X/Twitter (Cohen)
TWITTER_BEARER_TOKEN=your_twitter_token_here

# Event summaries / impact flows — Claude Sonnet, ingestion-time only (ADR-005)
ANTHROPIC_API_KEY=your_anthropic_key_here

# Database (everyone)
# Local dev (docker compose in development/): this exact URL works as-is.
# Port 5433 on purpose — see the note in development/docker-compose.yml.
DATABASE_URL=postgresql+psycopg://perennial:perennial@localhost:5433/perennial
